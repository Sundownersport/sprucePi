[Unit]
Description=spruce (PyUI)
After=multi-user.target sprucepi-firstboot.service
Conflicts=lightdm.service

[Service]
Type=idle
User=spruce
PAMName=login
TimeoutStartSec=infinity
ExecStartPre=+/opt/spruce/scripts/mount-data.sh
ExecStartPre=+/opt/spruce/scripts/wait-input.sh
ExecStartPre=+/opt/spruce/scripts/console-blank.sh
ExecStart=/opt/spruce/scripts/session.sh
Restart=on-failure
RestartSec=3
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
UtmpIdentifier=tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
